    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sass": "^1.105.1",
    "typescript": "^6.0.3"
  }
}
