  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "drift-check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/drift-check.mjs",
    "figma-snapshot": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/figma-snapshot.mjs",
    "token-drift": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/token-drift.mjs",
    "token-drift:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/token-drift.test.mjs",
    "component-snapshot": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/component-snapshot.mjs",
    "component-doc-drift": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/component-doc-drift.mjs",
    "component-doc-drift:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/component-doc-drift.test.mjs",
    "color:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/color.test.mjs",
    "naming-check": "node scripts/naming-check.mjs",
    "registry-check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/lib/register-alias.mjs scripts/registry-check.mjs"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.89.0",
